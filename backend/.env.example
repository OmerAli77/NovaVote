# Backend Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Network Configuration
# For local network access, set to 0.0.0.0
# For localhost only, use 127.0.0.1
HOST=0.0.0.0

# Blockchain Configuration
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=1337

# CORS Configuration
# Add your devices' IP addresses or use * for all origins (not recommended for production)
CORS_ORIGIN=*

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production
SESSION_TIMEOUT=3600000

# Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=novavote
# DB_USER=postgres
# DB_PASSWORD=your-password

# Redis Configuration (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Admin Access Control
# Set to true to restrict admin functions to localhost only (recommended)
ADMIN_LOCALHOST_ONLY=true
