# BLOCKCHAIN CONFIGURATION
# Copy this file to .env and fill in your actual values

# ==================== PRIVATE KEY ====================
# Your wallet private key (NEVER commit .env with real keys!)
# Get from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ==================== POLYGON MUMBAI (TESTNET) ====================
# Free RPC endpoints (or get your own from Alchemy/Infura)
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
# Alternative: https://matic-mumbai.chainstacklabs.com
# Alternative: https://polygon-mumbai.g.alchemy.com/v2/YOUR-API-KEY

# ==================== POLYGON MAINNET ====================
# Free RPC endpoint (or get your own for production)
POLYGON_MAINNET_RPC=https://polygon-rpc.com
# Alternative: https://polygon-mainnet.g.alchemy.com/v2/YOUR-API-KEY
# Alternative: https://rpc-mainnet.maticvigil.com

# ==================== BLOCK EXPLORER ====================
# Get free API key from https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ==================== DEPLOYMENT NOTES ====================
# 1. Get testnet MATIC from: https://faucet.polygon.technology/
# 2. For mainnet, you'll need real MATIC tokens
# 3. Recommended: Test on Mumbai first before mainnet deployment
# 4. Keep your .env file private and add it to .gitignore
